# Copia este archivo como .env y completa tus datos:
#   cp .env.example .env
# El .env está en .gitignore y nunca se sube al repositorio.

# --- Obligatorio: tus credenciales de INACAP ---------------------------------
# Con esto el archivador inicia y renueva la sesión de Moodle por su cuenta.
INACAP_USER=tu-correo@inacapmail.cl
INACAP_PASS=tu-contraseña

# --- Opcional: respaldo en Google Drive --------------------------------------
# Ejecuta primero `rclone config` y crea un remote (por ejemplo "gdrive").
# Déjalo vacío para no respaldar nada.
DRIVE_REMOTE=

# --- Opcional: avisos por Telegram -------------------------------------------
# Token que entrega @BotFather al crear el bot.
TELEGRAM_TOKEN=
# Tu chat personal con el bot. Ver el README para obtenerlo.
TELEGRAM_CHAT_ID=
